@model CatalogViewModel
@{
    ViewData["Title"] = "Каталог игр";
}

<h1 class="mb-4">Каталог игр</h1>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <label class="form-label">Платформа</label>
        <select name="platformId" class="form-select" onchange="this.form.submit()">
            <option value="">Все платформы</option>
            @foreach (var p in Model.Platforms)
            {
                <option value="@p.Id" selected="@(Model.SelectedPlatformId == p.Id)">
                    @p.Name
                </option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Жанр</label>
        <select name="genreId" class="form-select" onchange="this.form.submit()">
            <option value="">Все жанры</option>
            @foreach (var g in Model.Genres)
            {
                <option value="@g.Id" selected="@(Model.SelectedGenreId == g.Id)">
                    @g.Name
                </option>
            }
        </select>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
    </div>
</form>

@if (!Model.Products.Any())
{
    <div class="alert alert-info">По выбранным фильтрам ничего не найдено.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var product in Model.Products)
        {
            var img = product.Game.Images.FirstOrDefault()?.Url ?? "/images/placeholder.jpg";
            <div class="col">
                <div class="card h-100">
                    <img src="@img" class="card-img-top" alt="@product.Game.Title" style="height: 220px; object-fit: cover;" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@product.Game.Title</h5>
                        <p class="card-text text-muted mb-2">@product.Platform.Name</p>
                        <p class="card-text fw-bold mt-auto">@product.Price.ToString("C")</p>
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-primary btn-sm">Подробнее</a>
                            <form asp-controller="Cart" asp-action="Add" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@product.Id" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <button type="submit" class="btn btn-primary btn-sm">В корзину</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}